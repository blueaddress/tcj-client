---
import '../../../styles/global.css'
import HomeLayout from '../../../layouts/HomeLayout.astro';
import { PROJECTS_DATA } from '../../../data/project-details.js';
import ProjectDetailsPage from '../../../components/Projects/ProjectDetails/ProjectDetailsPage.jsx';
import WhatsAppButton from '../../../components/Shared/WhatsappButton';
import ZoomWrapper from '../../../components/Shared/ZoomWrapper.jsx';
import EnquiryPopup from '../../../components/Projects/ProjectDetails/EnquiryPopup';
export async function getStaticPaths() {
  return PROJECTS_DATA.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const siteUrl = "https://tcjrealty.in";
const ogImageUrl = `${siteUrl}${project.image}`;
---

<HomeLayout 
  title={`${project.projectName} | TCJ Realty`}
  ogImage={ogImageUrl}
  description={`${project.overview.description}`}
>
    <ZoomWrapper>
      <ProjectDetailsPage client:load project={project} />
    </ZoomWrapper>
  	<WhatsAppButton
      client:load
      phone="+919307741303"
      projectName={project.projectName}
      projectUrl={Astro.url.href}
    />
    <EnquiryPopup client:load projectName={project.projectName} />
</HomeLayout>